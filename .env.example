# Copy this file to ".env.local" and fill in the two values from Supabase:
# Supabase dashboard → your project → Project Settings → API Keys / Data API.
#
# Both values below are designed to be used in a web page (they are protected
# by the database's security rules). NEVER put the "secret" or "service_role"
# key in this file or anywhere in the app.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
